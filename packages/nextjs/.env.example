# Template for NextJS environment variables.

# For local development, copy this file, rename it to .env.local, and fill in the values.
# When deploying live, you'll need to store the vars in Vercel/System config.

# No credentials are hardcoded in the code; everything is read from these variables.
# NEXT_PUBLIC_* values are embedded in the browser bundle, so never put secrets in them.

# Required. WalletConnect Cloud project ID: https://cloud.walletconnect.com
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=
# Recommended. Sepolia RPC used by the frontend (e.g. https://ethereum-sepolia-rpc.publicnode.com).
# If unset, falls back to Alchemy (if key set) or viem's public default RPC.
NEXT_PUBLIC_SEPOLIA_RPC_URL=
# Recommended. Mainnet RPC, always used for the ETH/USD price and ENS names
# (e.g. https://ethereum-rpc.publicnode.com). viem's default mainnet RPC rate-limits browsers.
NEXT_PUBLIC_MAINNET_RPC_URL=
# Optional. Alchemy key, used when no RPC override is set for a network.
NEXT_PUBLIC_ALCHEMY_API_KEY=

# Pinata (server-side only — never prefix with NEXT_PUBLIC_).
# Generate a JWT at https://app.pinata.cloud/developers/api-keys with pinFileToIPFS + pinJSONToIPFS scopes.
PINATA_JWT=

# Public IPFS gateway used to resolve ipfs:// URIs in the UI. Trailing slash optional.
# Defaults to https://gateway.pinata.cloud/ipfs/ if unset.
NEXT_PUBLIC_IPFS_GATEWAY=
